# Copy to .env. Normal local Docker setup stores app state in Postgres and OVPN
# files in the Docker named volume `ovpn_data`; upload OVPN files from the dashboard.

# Optional: override Redis for gateway compatibility/runtime state.
# REDIS_URL=redis://redis:6379/0
# REDIS_STATE_KEY=portico:assignments-state
# REDIS_ASSIGNMENTS_MIRROR_FILE=1

# --- Optional: published proxy TCP ranges (must match gateway `ports` in docker-compose.yml) ---
# Host side: what LAN/VPS clients connect to. Width (LAST - FIRST + 1) must equal the container range width.
# DOCKER_PROXY_HOST_PORT_FIRST=58000
# DOCKER_PROXY_HOST_PORT_LAST=58515
# Container side: must align with dashboard portBase and location count.
# DOCKER_PROXY_CONTAINER_PORT_FIRST=50000
# DOCKER_PROXY_CONTAINER_PORT_LAST=50515
# Dashboard/gateway hint for host URLs (normally same as DOCKER_PROXY_HOST_PORT_FIRST).
# PUBLISHED_PROXY_PORT_BASE=58000

# --- Optional: same-port routing deployment (docker-compose.local-auth.yml) ---
# One shared public proxy password. Usernames in auth-routing routes select the route.
PROXY_GLOBAL_PASSWORD=change-me
# Public/local auth proxy ports.
# AUTH_HTTP_PORT=58680
# AUTH_SOCKS_PORT=58681
# SD Farm + ixBrowser sync (import SD Farm folder from the dashboard on each PC).
# IXBROWSER_API_BASE=http://host.docker.internal:53200/api/v2/
# IXBROWSER_PROXY_HOST=127.0.0.1
# Legacy server-path mode only: bind-mount a host folder to /sd-farm in compose manually.
# SD_FARM_HOST_PATH=/path/to/SD Farm
# SD_FARM_ROOT=/sd-farm

# --- Optional: Cloudflare Tunnel ---
# Set token below, then: docker compose --profile tunnel up -d
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Advanced legacy host bind override ---
# The default named volume is recommended. If you intentionally want a host folder
# instead, edit docker-compose.yml's ovpn_data volume to add driver_opts manually.
